# Copy to .env for local development only. Configure cloud secrets privately.
# Render backend: dedicated Atlas database with readWrite and transaction support.
BANKING_MONGODB_URI=
BANKING_MONGODB_DB=nexa_banking
BANKING_API_TOKEN=

# Horizon: use the Render HTTPS URL, matching API token and a separate signing key.
BANKING_BASE_URL=http://127.0.0.1:8080/
BANKING_MCP_SIGNING_KEY=
AGENT_HTTP_TIMEOUT_SECONDS=60

# Local stdio Inspector scope; JSON array. Start read-only, with no write grant.
BANKING_MCP_TRANSPORT=stdio
BANKING_MCP_CUSTOMER_IDS=["NXC-0010"]
BANKING_MCP_WRITE_GRANT=

# Local HTTP MCP / remote client (not needed by the imported Horizon server).
BANKING_MCP_PORT=9002
BANKING_MCP_TOKEN=
BANKING_MCP_AUTH_MODE=token
BANKING_MCP_URL=http://127.0.0.1:9002/mcp
BANKING_TRANSPORT=mcp

# Agent-side OAuth only: Fernet key and encrypted cache outside this repository.
BANKING_MCP_OAUTH_STORAGE_KEY=
# BANKING_MCP_OAUTH_DIRECTORY=/absolute/private/path/oauth

DD_TRACE_ENABLED=false
DD_SERVICE=nexa-banking-api
DD_ENV=training
LOG_LEVEL=INFO
